# Adapted from .claude/settings.json; prefix rules are not file ACLs.
# Arbitrary-position dangerous push flags require full-command review.
prefix_rule(pattern = ["git", "status"], decision = "allow")
prefix_rule(pattern = ["git", "log"], decision = "allow")
prefix_rule(pattern = ["git", "diff"], decision = "allow")
prefix_rule(pattern = ["git", "show"], decision = "allow")
prefix_rule(pattern = ["git", "branch"], decision = "allow")
prefix_rule(pattern = ["git", "remote"], decision = "allow")
prefix_rule(pattern = ["git", "fetch"], decision = "allow")
prefix_rule(pattern = ["git", "blame"], decision = "allow")
prefix_rule(pattern = ["git", "ls-files"], decision = "allow")
prefix_rule(pattern = ["git", "rev-parse"], decision = "allow")
prefix_rule(pattern = ["git", "add"], decision = "allow")
prefix_rule(pattern = ["git", "commit"], decision = "allow")
prefix_rule(pattern = ["git", "pull"], decision = "allow")
prefix_rule(pattern = ["git", "stash", "list"], decision = "allow")
prefix_rule(pattern = ["git", "config", "--get"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", "create"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", "comment"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", "view"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", "list"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", "diff"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", "checks"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", "status"], decision = "allow")
prefix_rule(pattern = ["gh", "run", "view"], decision = "allow")
prefix_rule(pattern = ["gh", "run", "list"], decision = "allow")
prefix_rule(pattern = ["gh", "workflow", "view"], decision = "allow")
prefix_rule(pattern = ["gh", "workflow", "list"], decision = "allow")
prefix_rule(pattern = ["gh", "repo", "view"], decision = "allow")
prefix_rule(pattern = ["gh", "auth", "status"], decision = "allow")
prefix_rule(pattern = ["uv", "run", "pytest"], decision = "allow")
prefix_rule(pattern = ["uv", "run", "ruff"], decision = "allow")
prefix_rule(pattern = ["uv", "run", "mypy"], decision = "allow")
prefix_rule(pattern = ["git", "push"], decision = "prompt", justification = "Kiểm tra toàn bộ flags và branch theo quy trình project.")
prefix_rule(pattern = ["git", "checkout"], decision = "prompt", justification = "Kiểm tra toàn bộ flags và branch theo quy trình project.")
prefix_rule(pattern = ["rm"], decision = "forbidden", justification = "Thao tác bị cấm trong quy trình; người dùng tự thực hiện nếu cần.")
prefix_rule(pattern = ["git", "clean"], decision = "forbidden", justification = "Thao tác bị cấm trong quy trình; người dùng tự thực hiện nếu cần.")
prefix_rule(pattern = ["git", "restore"], decision = "forbidden", justification = "Thao tác bị cấm trong quy trình; người dùng tự thực hiện nếu cần.")
prefix_rule(pattern = ["git", "reset", "--hard"], decision = "forbidden", justification = "Thao tác bị cấm trong quy trình; người dùng tự thực hiện nếu cần.")
prefix_rule(pattern = ["git", "branch", "-D"], decision = "forbidden", justification = "Thao tác bị cấm trong quy trình; người dùng tự thực hiện nếu cần.")
prefix_rule(pattern = ["git", "branch", "--delete", "--force"], decision = "forbidden", justification = "Thao tác bị cấm trong quy trình; người dùng tự thực hiện nếu cần.")
prefix_rule(pattern = ["git", "checkout", "--"], decision = "forbidden", justification = "Thao tác bị cấm trong quy trình; người dùng tự thực hiện nếu cần.")
prefix_rule(pattern = ["git", "checkout", "."], decision = "forbidden", justification = "Thao tác bị cấm trong quy trình; người dùng tự thực hiện nếu cần.")
prefix_rule(pattern = ["gh", "pr", "merge"], decision = "forbidden", justification = "Thao tác bị cấm trong quy trình; người dùng tự thực hiện nếu cần.")
prefix_rule(pattern = ["git", "push", "--force"], decision = "forbidden", justification = "Thao tác bị cấm trong quy trình; người dùng tự thực hiện nếu cần.")
prefix_rule(pattern = ["git", "push", "origin", "--force"], decision = "forbidden", justification = "Thao tác bị cấm trong quy trình; người dùng tự thực hiện nếu cần.")
prefix_rule(pattern = ["git", "push", "-f"], decision = "forbidden", justification = "Thao tác bị cấm trong quy trình; người dùng tự thực hiện nếu cần.")
prefix_rule(pattern = ["git", "push", "origin", "-f"], decision = "forbidden", justification = "Thao tác bị cấm trong quy trình; người dùng tự thực hiện nếu cần.")
prefix_rule(pattern = ["git", "push", "--delete"], decision = "forbidden", justification = "Thao tác bị cấm trong quy trình; người dùng tự thực hiện nếu cần.")
prefix_rule(pattern = ["git", "push", "origin", "--delete"], decision = "forbidden", justification = "Thao tác bị cấm trong quy trình; người dùng tự thực hiện nếu cần.")
prefix_rule(pattern = ["git", "push", "--force-with-lease"], decision = "forbidden", justification = "Thao tác bị cấm trong quy trình; người dùng tự thực hiện nếu cần.")
prefix_rule(pattern = ["git", "push", "origin", "--force-with-lease"], decision = "forbidden", justification = "Thao tác bị cấm trong quy trình; người dùng tự thực hiện nếu cần.")
prefix_rule(pattern = ["git", "push", "--force-if-includes"], decision = "forbidden", justification = "Thao tác bị cấm trong quy trình; người dùng tự thực hiện nếu cần.")
prefix_rule(pattern = ["git", "push", "origin", "--force-if-includes"], decision = "forbidden", justification = "Thao tác bị cấm trong quy trình; người dùng tự thực hiện nếu cần.")
